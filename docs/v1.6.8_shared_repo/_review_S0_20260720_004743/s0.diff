+    if (r.ok) expect(r.entries.length).toBe(3);
+  });
+
+  it("개행 없는 초장문 한 줄 거부(2GB single-line 시뮬)", async () => {
+    const p = join(jroot, "huge.jsonl");
+    // maxLineBytes 를 작게 줘서 무-개행 폭주 차단 실증(실제 2GB 안 쓰고 계약 검증).
+    await writeFile(p, "x".repeat(500_000)); // 개행 0
+    const r = await readJsonlSafe(p, { maxLineBytes: 1024 });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("line-too-long");
