+// regstore.test.ts — S0 untrusted 콘텐츠 안전 리더·파서 negative/positive 스위트(§0-4b·비협상).
+//   공격 fixture(심링크·거대·바이너리·traversal·YAML !!태그/alias 폭발·깊은 JSON/TOML·거대 single-line JSONL)
+//   전건 차단 실증. 정상 콘텐츠는 통과.
+import { describe, it, expect, beforeAll, afterAll } from "vitest";
+import { mkdtemp, rm, writeFile, symlink, mkdir } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  readRegFile,
+  safeParseYaml,
+  safeParseJson,
+  safeParseToml,
+  readJsonlSafe,
+  rawJsonDepth,
+  objectDepthExceeds,
+  REG_MAX_ARTIFACT,
+} from "../src/server/adapters/regstore.js";
+
+let root: string;
+const isWin = process.platform === "win32";
+
+beforeAll(async () => {
+  root = await mkdtemp(join(tmpdir(), "regstore-"));
+  await mkdir(join(root, "skills", "good"), { recursive: true });
+  await writeFile(join(root, "skills", "good", "SKILL.md"), "---\nname: good\n---\n# good\n본문.\n");
+  await writeFile(join(root, "index.json"), JSON.stringify({ entries: [] }));
+});
+afterAll(async () => {
+  await rm(root, { recursive: true, force: true });
+});
+
+describe("readRegFile — 경로/크기/바이너리 방어", () => {
+  it("정상 SKILL.md 통과", async () => {
+    const r = await readRegFile(root, ["skills", "good", "SKILL.md"], "skill-md");
+    expect(r.ok).toBe(true);
+    if (r.ok) expect(r.text).toContain("name: good");
+  });
+
+  it("traversal 세그먼트(..) 거부", async () => {
+    const r = await readRegFile(root, ["skills", "..", "..", "etc", "passwd"], "skill-md");
+    expect(r.ok).toBe(false);
+  });
+
+  it("불안전 세그먼트(%·절대경로 흉내) 거부", async () => {
+    const r = await readRegFile(root, ["skills", "..%2f", "SKILL.md"], "skill-md");
+    expect(r.ok).toBe(false);
+  });
+
+  it.skipIf(isWin)("경로 내 심링크 거부(SKILL.md → /etc/passwd)", async () => {
+    const evilDir = join(root, "skills", "evil");
+    await mkdir(evilDir, { recursive: true });
+    await symlink("/etc/passwd", join(evilDir, "SKILL.md")).catch(() => {});
+    const r = await readRegFile(root, ["skills", "evil", "SKILL.md"], "skill-md");
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toMatch(/symlink|not-file|not-found/);
+  });
+
+  it("크기 상한 초과 거부(> 256KB artifact)", async () => {
+    const big = join(root, "skills", "good", "BIG.md");
+    await writeFile(big, "x".repeat(REG_MAX_ARTIFACT + 10));
+    const r = await readRegFile(root, ["skills", "good", "BIG.md"], "skill-md");
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("too-large");
+  });
+
+  it("바이너리(NUL) 거부", async () => {
+    const bin = join(root, "skills", "good", "bin.md");
+    await writeFile(bin, Buffer.from([0x23, 0x00, 0x41, 0x42]));
+    const r = await readRegFile(root, ["skills", "good", "bin.md"], "skill-md");
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("binary-rejected");
+  });
+});
+
+describe("safeParseYaml — 코드태그/alias/깊이 방어", () => {
+  it("정상 YAML 통과", () => {
+    const r = safeParseYaml("name: foo\ntools:\n  - a\n  - b\n");
+    expect(r.ok).toBe(true);
+  });
+
+  it("!!js/function 코드 실행 태그 거부", () => {
+    const r = safeParseYaml("evil: !!js/function 'function(){return process}'\n");
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("unsafe-yaml-tag");
+  });
+
+  it("커스텀 !!python/object 태그 거부", () => {
+    const r = safeParseYaml("x: !!python/object/apply:os.system ['id']\n");
+    expect(r.ok).toBe(false);
+  });
+
+  it("alias 폭발(billion-laughs) 거부", () => {
+    // 확장 시 지수 폭발하는 alias 참조 다발.
+    let y = "a: &a [x,x,x,x,x,x,x,x,x,x]\n";
+    y += "b: &b [*a,*a,*a,*a,*a,*a,*a,*a,*a,*a]\n";
+    y += "c: &c [*b,*b,*b,*b,*b,*b,*b,*b,*b,*b]\n";
+    y += "d: &d [*c,*c,*c,*c,*c,*c,*c,*c,*c,*c]\n";
+    y += "e: [*d,*d,*d,*d,*d,*d,*d,*d,*d,*d]\n";
+    const r = safeParseYaml(y);
+    expect(r.ok).toBe(false); // maxAliasCount 초과 throw
+  });
+});
+
+describe("safeParseJson — 크기/깊이 방어", () => {
+  it("정상 JSON 통과", () => {
+    const r = safeParseJson('{"entries":[{"id":"a"}]}');
+    expect(r.ok).toBe(true);
+  });
+
+  it("깊은 중첩 거부(> 64)", () => {
+    const deep = "[".repeat(200) + "]".repeat(200);
+    const r = safeParseJson(deep);
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("json-too-deep");
+  });
+
+  it("크기 상한 초과 거부", () => {
+    const r = safeParseJson('{"x":1}', 3);
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("too-large");
+  });
+
+  it("rawJsonDepth 는 문자열 내부 괄호 무시", () => {
+    expect(rawJsonDepth('{"k":"[[[[["}')).toBe(1); // 문자열 안 [ 는 미집계
+    expect(rawJsonDepth("[[[]]]")).toBe(3);
+  });
+});
+
+describe("safeParseToml — 크기/깊이 방어", () => {
+  it("정상 TOML 통과", () => {
+    const r = safeParseToml('name = "foo"\n[meta]\nowner = "a"\n');
+    expect(r.ok).toBe(true);
+  });
+
+  it("malformed TOML 거부(throw 흡수)", () => {
+    const r = safeParseToml("= = =\n");
+    expect(r.ok).toBe(false);
+  });
+
+  it("크기 상한 초과 거부", () => {
+    const r = safeParseToml('a = "xxxxxxxxxx"\n', 5);
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("too-large");
+  });
+});
+
+describe("objectDepthExceeds — 노드 예산/깊이", () => {
+  it("얕은 객체 통과", () => {
+    expect(objectDepthExceeds({ a: { b: 1 } }, 64)).toBe(false);
+  });
+  it("깊은 객체 거부", () => {
+    let o: unknown = 1;
+    for (let i = 0; i < 100; i++) o = { n: o };
+    expect(objectDepthExceeds(o, 64)).toBe(true);
+  });
+});
+
+describe("readJsonlSafe — 스트리밍 max-line 방어", () => {
+  let jroot: string;
+  beforeAll(async () => {
+    jroot = await mkdtemp(join(tmpdir(), "jsonl-"));
+  });
+  afterAll(async () => {
+    await rm(jroot, { recursive: true, force: true });
+  });
+
+  it("정상 JSONL 파싱", async () => {
+    const p = join(jroot, "ok.jsonl");
+    await writeFile(p, '{"a":1}\n{"b":2}\n{"c":3}\n');
+    const r = await readJsonlSafe(p);
