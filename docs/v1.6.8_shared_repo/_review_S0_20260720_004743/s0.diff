@@ -0,0 +1,77 @@
+# 팀 공유 레지스트리 규약 (harness-registry · S0)
+
+> 이 디렉토리는 **팀 공유 레지스트리 repo 의 표준 구조 예시**다(별도 사설 git repo 로 복제해 사용).
+> 규약 = 스킬·에이전트를 팀이 PR 로 올리고, CI 가 자동채점하고, 사용자가 검토 후 설치하는 형식.
+> 근거: [`../design.md`](../design.md) §1·§2 · [`../prd.md`](../prd.md) AR1~AR3.
+
+## 표준 디렉토리 구조
+
+```
+<registry-repo>/
+├── skills/
+│   └── {name}/
+│       ├── SKILL.md          # 3런타임 공통 포맷(claude·codex·gemini 동일)
+│       └── meta.json         # owner·runtimeOrigin·version·tags·endorse·discussionUrl
+├── agents/
+│   └── {name}/
+│       ├── agent.ir.json     # (S2) 중립 IR — 이종 포팅의 진실 소스
+│       ├── claude.md         # (있으면) Claude/Gemini md-frontmatter 렌더물
+│       ├── codex.toml        # (있으면) Codex TOML 렌더물
+│       ├── gemini.md         # (있으면) Gemini md 렌더물
+│       └── meta.json
+├── index.json                # 카탈로그(CI 생성·검증 — 수기 편집 금지)
+└── .github/workflows/eval.yml # PR 자동채점 CI
+```
+
+- **경로 규약:** `{name}` 은 `[A-Za-z0-9._-]+`(안전 세그먼트). `skills/*/`·`agents/*/`·`index.json`·`meta.json` 만 정규 텍스트로 취급. 그 외·심링크·바이너리·거대 파일은 채점기가 **거부(skipped)**.
+- **스킬-먼저:** 스킬은 세 런타임 `SKILL.md` 포맷이 동일 → 번역 없이 이종 설치(라이브 dogfood 실증·§선검증 P-1). **설치 채널은 런타임별로 다름**: claude=`.claude/skills`·codex=`.agents/skills`(공유)·**gemini=`.gemini/skills`**(공유 `.agents/skills` 미discovery·dogfood 정정).
+- **에이전트:** 포맷이 런타임마다 다름(md↔TOML) → **포팅 초안 + 손실 보고**(S2·자동 호환 아님·§선검증 P-2).
+
+## index.json 스키마
+
+```jsonc
+{
+  "schema": "harness-registry/index@1",
+  "generatedAt": "2026-07-20",           // CI 주입(결정적)
+  "entries": [{
+    "id": "skill/greet-team",            // "{kind}/{name}"
+    "kind": "skill",                      // skill | agent
+    "name": "greet-team",
+    "runtimeOrigin": "claude",            // claude | codex | gemini (meta.json)
+    "owner": "alice",                     // git author 파생(meta.json)
+    "version": "1.0.0",
+    "description": "",                    // 카탈로그는 요약만(본문은 검토 관문 diff 로 — 원격 자동 신뢰 금지)
+    "requires": { "tools": [], "model": null },  // 선언 tools=비신뢰 참고(안전 경계 아님·§design §3-1)
+    "eval": { "grade": "C", "mode": "static", "confidence": 0.5 },  // #/eval 4축 정적(품질·비안전)
+    "endorse": 2,                         // ★ 집계
+    "discussionUrl": null                 // GitHub Discussions 스레드(의견·경험지)
+  }]
+}
+```
+
+스키마 검증 = `regstore-index.ts`(zod) + `regstore.safeParseJson`(크기·깊이 DoS 방어).
+
+## meta.json (아티팩트별)
+
+```json
+{ "owner": "alice", "runtimeOrigin": "claude", "version": "1.0.0",
+  "tags": ["team"], "endorse": 2, "discussionUrl": null }
+```
+
+## CI 자동채점 (AR2)
+
+PR 마다 `eval.yml` 이 채점기 번들을 실행:
+
+```bash
+node eval-registry.mjs <registry-root>            # 검증만(stdout: summary + index)
+node eval-registry.mjs <registry-root> --write    # index.json 갱신(CI 만)
+node eval-registry.mjs <registry-root> --block-d  # D등급 있으면 exit 1(머지 차단·옵션)
+```
+
+- 등급 = `#/eval` 4축 정적 채점(트리거·구조·유도·가지치기) 재사용. **"품질 등급 ≠ 안전"** — 안전은 별도 사람 검토(본문·권한·시크릿).
+- 오염 아티팩트(심링크·거대·바이너리)는 채점 대상서 **제외(skipped)**·CI 로그에 명시(은폐 금지).
+- **보안(§0-4b):** 채점기는 모든 read 를 안전 리더로 — 심링크 거부·크기 상한(아티팩트 256KB·index 16MB)·바이너리 거부·경로 allowlist·YAML `!!` 코드태그/alias 폭발/깊이·JSON/TOML 깊이·JSONL 스트리밍 max-line 방어.
+
+## 게이트 (물리 강제 · plan §0-3)
+
+`eval.yml` 단독은 pwn-request 에 완전 면역이 아니다(PR 이 워크플로를 고칠 수 있음). 실제 게이트 = **branch protection + CODEOWNERS(`.github/workflows/` 소유자 승인) + required status check("registry-eval") + "Include administrators" ON**, 또는 org-level required workflows. 신뢰 경계 = 팀·상호신뢰 + 사람 본문 검토 + 런타임 샌드박스(스캔은 advisory 신호지 경계가 아님).
diff --git a/harness-ui/src/server/adapters/regstore-cli.ts b/harness-ui/src/server/adapters/regstore-cli.ts
new file mode 100644
index 0000000..4ee202f
--- /dev/null
+++ b/harness-ui/src/server/adapters/regstore-cli.ts
@@ -0,0 +1,34 @@
+// portable CLI 엔트리(S0·AR2) — esbuild 로 scripts/eval-registry.mjs 로 번들(무의존·서버 불요).
+//   레지스트리 repo CI 가 vendor/실행: node eval-registry.mjs <registry-root> [--write] [--block-d]
+//     기본:      채점 결과 + index JSON 을 stdout(검증만·부작용 없음).
+//     --write:   <root>/index.json 갱신(CI 생성·수기 편집 금지).
+//     --block-d: D등급 아티팩트 있으면 exit 1(머지 차단 게이트·옵션).
+//   모든 read 는 regstore 안전 리더(심링크 거부·크기캡·바이너리 거부·경로 allowlist) 경유.
+import { writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { evaluateRegistry } from "./regstore-eval.js";
+
+const args = process.argv.slice(2);
+const write = args.includes("--write");
+const blockD = args.includes("--block-d");
+const root = args.find((a) => !a.startsWith("--")) || process.cwd();
+const now = new Date().toISOString().slice(0, 10);
+
+evaluateRegistry(root, { now })
+  .then(async (r) => {
+    if (write) await writeFile(join(root, "index.json"), JSON.stringify(r.index, null, 2) + "\n", "utf8");
+    const dGrades = r.index.entries.filter((e) => e.eval.grade === "D");
+    const summary = {
+      artifacts: r.index.entries.length,
+      grades: r.index.entries.reduce((m, e) => ((m[e.eval.grade] = (m[e.eval.grade] ?? 0) + 1), m), {} as Record<string, number>),
+      skipped: r.skipped,
+      dBlocked: blockD ? dGrades.map((e) => e.id) : [],
+    };
+    process.stdout.write(JSON.stringify(write ? summary : { summary, index: r.index }, null, 2) + "\n");
+    if (r.skipped.length > 0) process.stderr.write(`[reg-eval] ${r.skipped.length} artifact(s) skipped(오염·거부): ${r.skipped.map((s) => s.path).join(", ")}\n`);
+    if (blockD && dGrades.length > 0) {
+      process.stderr.write(`[reg-eval] D-grade 머지 차단: ${dGrades.map((e) => e.id).join(", ")}\n`);
+      process.exit(1);
+    }
+  })
+  .catch((e) => { process.stderr.write(String(e?.stack || e) + "\n"); process.exit(1); });
diff --git a/harness-ui/src/server/adapters/regstore-eval.ts b/harness-ui/src/server/adapters/regstore-eval.ts
new file mode 100644
index 0000000..e4f96bd
--- /dev/null
+++ b/harness-ui/src/server/adapters/regstore-eval.ts
@@ -0,0 +1,97 @@
+// regstore-eval.ts — 레지스트리 CI 자동채점(S0·AR2). 비신뢰 레지스트리 콘텐츠를 **안전 리더**로 읽어
+//   임시 런타임-채널 레이아웃으로 materialize → 기존 evaluateArtifacts(#/eval 4축) **무변경 재사용**(zero blast radius)
+//   → 등급/지적 산출 + index.json 카탈로그 생성. CI 가 PR 마다 실행(D등급 머지 차단은 옵션).
+//   모든 read 는 regstore(심링크 거부·크기캡·바이너리 거부·경로 allowlist) 경유 — 원격 오염 콘텐츠 격리.
+import { mkdtemp, rm, mkdir, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { evaluateArtifacts, type ArtifactScore } from "./artifacteval.js";
+import { readRegFile, listRegDirs } from "./regstore.js";
+import { parseMeta, IndexSchema, type IndexEntry, type RegistryIndex } from "./regstore-index.js";
+
+// 레지스트리 아티팩트 origin 포맷별 materialize 대상 채널(F12).
+const AGENT_FILES: Array<{ file: string; kind: "agent-md" | "agent-toml"; dest: (n: string) => string[] }> = [
+  { file: "claude.md", kind: "agent-md", dest: (n) => [".claude", "agents", `${n}.md`] },
+  { file: "codex.toml", kind: "agent-toml", dest: (n) => [".codex", "agents", `${n}.toml`] },
+  { file: "gemini.md", kind: "agent-md", dest: (n) => [".gemini", "agents", `${n}.md`] },
+];
+
+export interface RegistryEval {
+  index: RegistryIndex;
+  scores: ArtifactScore[];
+  skipped: Array<{ path: string; reason: string }>; // 안전 리더가 거부한 아티팩트(은폐 금지·명시)
+}
+
+// 안전 read → tmp 채널 파일 기록. 실패(거부)면 skipped 기록.
+async function materialize(
+  root: string,
+  segs: string[],
+  kind: Parameters<typeof readRegFile>[2],
+  tmp: string,
+  dest: string[],
+  skipped: RegistryEval["skipped"],
+): Promise<boolean> {
+  const r = await readRegFile(root, segs, kind);
+  if (!r.ok) {
+    skipped.push({ path: segs.join("/"), reason: r.error });
+    return false;
+  }
+  const full = join(tmp, ...dest);
+  await mkdir(join(full, ".."), { recursive: true });
+  await writeFile(full, r.text, "utf8");
+  return true;
+}
+
+// 레지스트리 root 를 CI 채점 → index.json + 점수. now = 결정적 타임스탬프(CI 주입).
+export async function evaluateRegistry(root: string, opts?: { now?: string }): Promise<RegistryEval> {
+  const now = opts?.now ?? "2026-01-01";
+  const skipped: RegistryEval["skipped"] = [];
+  const tmp = await mkdtemp(join(tmpdir(), "reg-eval-"));
+  // 이름 → meta(origin/owner/discussion) 색인.
+  const metaByName = new Map<string, ReturnType<typeof parseMeta>>();
+  try {
+    // ── 스킬: skills/{name}/SKILL.md → .claude/skills/{name}/SKILL.md ──
+    for (const name of await listRegDirs(root, "skills")) {
+      const ok = await materialize(root, ["skills", name, "SKILL.md"], "skill-md", tmp, [".claude", "skills", name, "SKILL.md"], skipped);
+      if (!ok) continue;
+      const m = await readRegFile(root, ["skills", name, "meta.json"], "meta");
+      metaByName.set("skill|" + name, parseMeta(m.ok ? m.text : null));
+    }
+    // ── 에이전트: agents/{name}/{claude.md|codex.toml|gemini.md} → 각 채널 ──
+    for (const name of await listRegDirs(root, "agents")) {
+      let placed = false;
+      for (const a of AGENT_FILES) {
+        const ok = await materialize(root, ["agents", name, a.file], a.kind, tmp, a.dest(name), skipped);
+        if (ok) placed = true;
+      }
+      if (!placed) continue;
+      const m = await readRegFile(root, ["agents", name, "meta.json"], "meta");
+      metaByName.set("agent|" + name, parseMeta(m.ok ? m.text : null));
+    }
+
+    // ── 기존 4축 평가 재사용(무변경) ──
+    const evalResult = await evaluateArtifacts(tmp, { now });
+
+    // ── index 엔트리 조립(eval + meta 조인) ──
+    const entries: IndexEntry[] = evalResult.artifacts.map((a) => {
+      const meta = metaByName.get(a.kind + "|" + a.name) ?? parseMeta(null);
+      return {
+        id: `${a.kind}/${a.name}`,
+        kind: a.kind,
+        name: a.name,
+        runtimeOrigin: meta.runtimeOrigin,
+        owner: meta.owner,
+        version: meta.version,
+        description: "", // 카탈로그는 요약만(본문은 diff/검토 관문서 — 원격 자동 신뢰 금지)
+        requires: { tools: [], model: null },
+        eval: { grade: a.grade, mode: "static" as const, confidence: a.confidence },
+        endorse: meta.endorse,
+        discussionUrl: meta.discussionUrl,
+      };
+    });
+    const index = IndexSchema.parse({ schema: "harness-registry/index@1", generatedAt: now, entries });
+    return { index, scores: evalResult.artifacts, skipped };
+  } finally {
+    await rm(tmp, { recursive: true, force: true });
+  }
+}
