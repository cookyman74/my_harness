@@ -0,0 +1,77 @@
+# 레지스트리 CI 자동채점(S0·AR2) — PR 마다 아티팩트 4축 채점 + index.json 검증.
+#
+# 보안 자세(plan §0-3 · pwn-request 방어):
+#   - permissions: contents:read 만(GITHUB_TOKEN read-only) — 토큰 exfil 표면 최소화.
+#   - secrets 미주입 — 평가는 순수 정적 채점(외부 자격 불요).
+#   - PR 콘텐츠(skills/·agents/·index.json)는 **비신뢰 데이터**로만 취급 — 실행하지 않는다.
+#     채점기는 regstore 안전 리더(심링크 거부·크기캡·바이너리 거부·경로 allowlist)로만 읽는다.
+#   - 채점기 번들은 **고정 ref** 의 harness-ui 에서 가져온다(PR 이 채점기 로직을 못 바꾸게).
+#
+# ⚠ 진짜 pwn-request 면역(정직한 한계·plan §0-3):
+#   pull_request 는 PR 브랜치의 이 워크플로 '정의'를 즉시 실행한다 → PR 이 eval.yml 자체를 고치면 우회 가능.
+#   → 실제 게이트는 아래 중 하나로 굳혀야 한다(이 파일만으로는 불충분):
+#     (a) org-level "required workflows"(default 브랜치 정의 강제), 또는
+#     (b) branch protection + CODEOWNERS 로 .github/workflows/ 편집에 소유자 승인 필수 +
+#         required status check 이름 고정("registry-eval") + "Include administrators" ON.
+#   이 워크플로는 심층방어이지, 결탁 내부자를 막는 증명이 아니다(대상=팀·상호신뢰·§설계 §3-0).
+
+name: registry-eval
+on:
+  pull_request:
+    paths: ["skills/**", "agents/**", "index.json"]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: registry-eval-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  eval:
+    runs-on: ubuntu-latest
+    steps:
+      # PR 콘텐츠 = 비신뢰 데이터. 별도 디렉토리(registry/)에 체크아웃하고 실행하지 않는다.
+      - name: Checkout PR content (untrusted data)
+        uses: actions/checkout@v4
+        with:
+          path: registry
+          persist-credentials: false
+
+      # 채점기 = 고정 ref 의 harness-ui 번들(PR 이 못 바꿈).
+      - name: Fetch evaluator (pinned)
+        uses: actions/checkout@v4
+        with:
+          repository: your-org/harness   # ← 팀 harness 레포로 교체
+          ref: v1.6.8                     # ← 고정 태그(가변 브랜치 금지)
+          path: evaluator
+          persist-credentials: false
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+
+      # 번들이 커밋돼 있으면 그대로 실행. 아니면 빌드(build:reg-eval).
+      - name: Build evaluator bundle if missing
+        working-directory: evaluator/harness-ui
+        run: |
+          if [ ! -f scripts/eval-registry.mjs ]; then
+            npm ci
+            npm run build:reg-eval
+          fi
+
+      # 채점 + index.json 검증. --block-d 로 D등급 머지 차단(옵션).
+      - name: Evaluate registry
+        run: |
+          node evaluator/harness-ui/scripts/eval-registry.mjs "$GITHUB_WORKSPACE/registry" --block-d > eval-summary.json
+          cat eval-summary.json
+
+      # index.json 이 CI 산출과 일치하는지 검증(수기 편집 차단).
+      - name: Verify index.json matches CI output
+        run: |
+          node evaluator/harness-ui/scripts/eval-registry.mjs "$GITHUB_WORKSPACE/registry" --write
+          if ! git -C registry diff --quiet index.json; then
+            echo "::error::index.json 이 CI 생성물과 다릅니다(수기 편집 금지). 커밋된 index.json 을 CI 출력으로 교체하세요."
+            git -C registry --no-pager diff index.json
+            exit 1
+          fi
