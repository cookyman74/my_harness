+
+  it("총 줄수 상한 초과 거부", async () => {
+    const p = join(jroot, "many.jsonl");
+    await writeFile(p, '{"a":1}\n'.repeat(50));
+    const r = await readJsonlSafe(p, { maxLines: 10 });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error).toBe("too-many-lines");
+  });
+});
